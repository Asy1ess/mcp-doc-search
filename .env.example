# Embedding: local | openai | ...
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3

# Index data (inside container: /app/data)
CHROMA_PERSIST_DIR=/app/data/chroma
SQLITE_PATH=/app/data/index.db

# Host path to mount as /documents in docker-compose (edit for your machine)
DOCUMENTS_PATH=C:\Users\you\Documents

# Default folders to index (comma-separated, container paths)
INDEX_FOLDERS=/documents

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100
